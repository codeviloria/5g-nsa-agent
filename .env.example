# Copy to .env and edit. Never commit .env.
OLLAMA_HOST=http://192.168.1.7:11434
MODEL=qwen3:8b                 # needs tools. qwen3:8b held the 4-tool loop; gemma4:e2b did not (see runs/). NOT gemma3
THINK=false                    # gemma4/qwen3 think by default; false = much faster on CPU

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=5g-nsa-agent
